{
  "name": "real-estate/backend",
  "description": "Real Estate Management System - Backend API",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "laravel/tinker": "^2.9",
    "tymon/jwt-auth": "^2.1",
    "league/csv": "^9.14",
    "barryvdh/laravel-dompdf": "^2.1",
    "laravel/cors": "^2.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.14",
    "laravel/sail": "^1.26",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.0",
    "spatie/laravel-ignition": "^2.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\": "database/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Filesystem\\ClassFinder::findClasses(function () {});"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php artisan storage:link"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
